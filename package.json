{
  "name": "aidlc-dashboard",
  "description": "Read-only web dashboard for an AI-DLC v2 run: status, progress, blockers, timing, health.",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "typecheck": "bunx tsc -p ./ --noEmit",
    "lint": "bunx --bun @biomejs/biome check src/ scripts/",
    "format": "bunx --bun @biomejs/biome format --write src/ scripts/",
    "verify": "bun run typecheck && bun run lint && bun test && bun run audit",
    "audit": "bun run scripts/audit-repo.ts",
    "package": "bun run scripts/package.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.3.5",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
