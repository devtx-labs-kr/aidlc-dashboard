# Windows launchers MUST keep CRLF. cmd.exe mis-parses a LF-only .cmd (a trailing
# LF can swallow the last line, and `goto`/`if` blocks break), so pin them rather
# than leaving it to the checkout's core.autocrlf.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# The macOS/Linux launcher must stay LF — CRLF would make the shebang line read
# as `#!/usr/bin/env bash\r` and fail with "bad interpreter".
*.command text eol=lf
